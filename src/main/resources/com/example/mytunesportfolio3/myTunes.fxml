<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Point3D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mytunesportfolio3.myTunesController">
   <children>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox alignment="TOP_RIGHT" prefHeight="70.0" prefWidth="200.0">
               <children>
                  <Label text="Playlists">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="65.0" top="29.0" />
                     </HBox.margin>
                  </Label>
                  <Label text="Filter:">
                     <HBox.margin>
                        <Insets right="5.0" top="29.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="filterSearch">
                     <HBox.margin>
                        <Insets right="5.0" top="25.0" />
                     </HBox.margin>
                  </TextField>
                  <Button mnemonicParsing="false" onAction="#searchIcon" prefHeight="26.0" prefWidth="30.0">
                     <HBox.margin>
                        <Insets right="5.0" top="25.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="playlists" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="350.0">
              <columns>
                <TableColumn fx:id="nameKolonne" prefWidth="75.0" text="Name" />
                <TableColumn fx:id="songsKolonne" prefWidth="75.0" text="Songs" />
                  <TableColumn fx:id="timeKolonne" prefWidth="75.0" text="Time" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <VBox.margin>
                  <Insets left="25.0" />
               </VBox.margin>
            </TableView>
            <HBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="100.0" prefWidth="350.0">
               <VBox.margin>
                  <Insets left="25.0" top="10.0" />
               </VBox.margin>
               <children>
                  <Button mnemonicParsing="false" onAction="#newPlaylist" text="New" />
                  <Button mnemonicParsing="false" onAction="#editPlaylist" text="Edit">
                     <HBox.margin>
                        <Insets left="85.0" right="85.0" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#deletePlaylist" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox alignment="TOP_RIGHT" prefHeight="70.0" prefWidth="200.0">
               <children>
                  <Label alignment="TOP_LEFT" maxHeight="-Infinity" minHeight="-Infinity" text="Songs on playlist">
                     <font>
                        <Font name="System Bold Italic" size="13.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="75.0" top="29.0" />
                     </HBox.margin>
                  </Label>
                  <Button mnemonicParsing="false" onAction="#alleSange" text="Alle sange">
                     <HBox.margin>
                        <Insets top="25.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="songsOnPlaylist" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="250.0">
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
               <columns>
                  <TableColumn fx:id="numberKolonne" prefWidth="53.0" text="Number" />
                  <TableColumn fx:id="songKolonne" prefWidth="195.0" text="Song" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets left="15.0" top="10.0" />
               </VBox.margin>
               <children>
                  <Button alignment="TOP_CENTER" mnemonicParsing="false" onAction="#songUp" text="Up" />
                  <Button alignment="TOP_CENTER" mnemonicParsing="false" onAction="#songDown" text="Down">
                     <HBox.margin>
                        <Insets left="35.0" right="35.0" />
                     </HBox.margin>
                  </Button>
                  <Button alignment="TOP_CENTER" mnemonicParsing="false" onAction="#deleteSong" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox minWidth="-Infinity" prefHeight="200.0" prefWidth="300.0">
         <HBox.margin>
            <Insets left="25.0" right="25.0" />
         </HBox.margin>
         <children>
            <ImageView fx:id="songCover" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets left="25.0" top="100.0" />
               </VBox.margin>
            </ImageView>
            <HBox alignment="CENTER" maxHeight="-Infinity" prefHeight="25.0" prefWidth="200.0">
               <children>
                  <Label fx:id="playingSong" alignment="CENTER" contentDisplay="CENTER">
                     <HBox.margin>
                        <Insets top="5.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#songBack" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 50%;">
                     <HBox.margin>
                        <Insets top="7.5" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#playSong" prefHeight="50.0" prefWidth="50.0" style="-fx-background-radius: 50%;">
                     <rotationAxis>
                        <Point3D />
                     </rotationAxis>
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#nextSong" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 50%;">
                     <HBox.margin>
                        <Insets top="7.5" />
                     </HBox.margin>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
